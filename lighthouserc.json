{
  "ci": {
    "collect": {
      "url": [
        "https://www.nedabah.org/",
        "https://www.nedabah.org/about.html",
        "https://www.nedabah.org/programs.html",
        "https://www.nedabah.org/tools.html",
        "https://www.nedabah.org/contact.html",
        "https://www.nedabah.org/auto/tools/lead-scoring/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "skipAudits": [
          "uses-http2",
          "canonical"
        ]
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "uses-text-compression": "off",
        "uses-long-cache-ttl": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
