{
  "name": "nedabah-app",
  "version": "0.1.0",
  "private": true,
  "description": "Nedabahway 코칭 SaaS — 5트랙 1:1 플랫폼 (베타 1기)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db reset --no-seed && supabase db push && psql \"$SUPABASE_DB_URL\" -f supabase/seed.sql || echo 'use db:reset for seed'",
    "seed:users": "tsx --env-file=.env.local scripts/seed-users.ts",
    "embed:responses": "tsx --env-file=.env.local scripts/embed-responses.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@hookform/resolvers": "^3.9.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "2.49.4",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "next": "16.0.0",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.53.2",
    "recharts": "^2.13.3",
    "resend": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@tailwindcss/postcss": "^4.0.0-beta.4",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^2.1.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "16.0.0",
    "postcss": "^8.4.49",
    "supabase": "^1.226.4",
    "tailwindcss": "^4.0.0-beta.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
