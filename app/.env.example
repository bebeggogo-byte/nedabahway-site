# ============================================================
# nedabah-app — 환경 변수 (사장님 세팅용)
# 사용 방법: 이 파일을 .env.local 로 복사 → 값 채우기 → pnpm dev
# ============================================================

# ── Supabase (필수, 5분 부팅의 핵심) ─────────────────────────
# 1) https://supabase.com 접속 → New project
# 2) 프로젝트 만들면 아래 3개 키가 나옴 (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx_anon_key_xxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxx_service_role_xxx

# DB connection string (마이그레이션·시드용)
# Settings → Database → Connection string → URI → "Use connection pooling" 옆 ▾
SUPABASE_DB_URL=postgresql://postgres.xxx:[email protected]:6543/postgres

# ── 사이트 URL (배포 후 변경) ────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 토스페이먼츠 (선택, 미설정 시 mock 모달로 결제 동작) ────
# https://docs.tosspayments.com → 가맹 신청 → 테스트 키
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxx
TOSS_SECRET_KEY=test_sk_xxx

# ── Anthropic (선택, 미설정 시 AI 가이드 stub) ──────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-opus-4-7

# ── Voyage AI 임베딩 (선택, 미설정 시 cron 즉시 종료) ───────
# https://www.voyageai.com → API
VOYAGE_API_KEY=

# ── Resend 이메일 (선택, 미설정 시 console.log fallback) ────
# https://resend.com → API Keys
RESEND_API_KEY=re_xxx
[email protected]

# ── OAuth (선택, Supabase 콘솔에서 별도 설정) ───────────────
# Auth → Providers → Google/Kakao 토글 + Client ID/Secret
# 키 미설정이면 이메일 로그인만 노출됨
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_OAUTH_KAKAO_ENABLED=false

# ── 운영 ─────────────────────────────────────────────────────
NODE_ENV=development
