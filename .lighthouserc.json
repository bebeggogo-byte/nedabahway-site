{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/p/index.html",
        "http://localhost/p/starcp.html",
        "http://localhost/p/iden-teacher.html",
        "http://localhost/p/iden-career.html",
        "http://localhost/p/changjig.html",
        "http://localhost/p/5s-leadership.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        },
        "skipAudits": [
          "uses-http2",
          "canonical",
          "valid-source-maps",
          "csp-xss",
          "is-on-https"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.80 }],
        "categories:accessibility": ["error", { "minScore": 0.85 }],
        "categories:best-practices": ["warn", { "minScore": 0.85 }],
        "categories:seo": ["error", { "minScore": 0.90 }],
        "color-contrast": "error",
        "html-has-lang": "error",
        "html-lang-valid": "error",
        "meta-description": "error",
        "document-title": "error",
        "image-alt": "error",
        "link-name": "error",
        "is-crawlable": "error",
        "viewport": "error",
        "tap-targets": "warn",
        "errors-in-console": "warn",
        "uses-rel-preconnect": "warn",
        "unused-javascript": "off",
        "unused-css-rules": "off",
        "render-blocking-resources": "warn",
        "structured-data": "warn",
        "robots-txt": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
