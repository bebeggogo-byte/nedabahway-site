# Trot Automation — Environment Configuration
# Copy to .env and fill values. NEVER commit .env.

# ---- n8n core ----
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
N8N_JWT_SECRET=

# ---- LLM (Anthropic Claude) ----
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Default models per auto-decision D-2.3
CLAUDE_SCRIPT_MODEL=claude-sonnet-4-6
CLAUDE_CLASSIFY_MODEL=claude-haiku-4-5-20251001

# ---- News ingestion ----
# Naver Developer API — https://developers.naver.com/
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Comma-separated RSS feed URLs (trot-related)
RSS_FEEDS=

# ---- Notion catalog ----
# Internal integration token — https://www.notion.so/my-integrations
NOTION_TOKEN=
# Database IDs (created per docs/notion-schema.md)
NOTION_DB_RAW_NEWS=
NOTION_DB_PIPELINE_RUNS=
NOTION_DB_BGM_LIBRARY=
NOTION_DB_PERFORMANCE=

# ---- TTS ----
# 'edge' (free, default) or 'elevenlabs'
TTS_PROVIDER=edge
# Edge TTS voice (Korean female narrator)
EDGE_TTS_VOICE=ko-KR-SunHiNeural
# Only required if TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- Image generation ----
# 'pollinations' (free, default), 'stability', or 'together'
IMAGE_PROVIDER=pollinations
STABILITY_API_KEY=
TOGETHER_API_KEY=

# ---- YouTube ----
# OAuth2 client secrets file path (mount into worker at /secrets/)
YOUTUBE_CLIENT_SECRETS=/secrets/youtube-client-secrets.json
YOUTUBE_TOKEN=/secrets/youtube-token.json
YOUTUBE_CHANNEL_HANDLE=

# ---- Budget guard ----
BUDGET_MAX_KRW=500000
BUDGET_HALT_PCT=90
# Telegram or Discord webhook for alerts
ALERT_WEBHOOK=

# ---- Channel identity ----
CHANNEL_ID=trot-radio-01
CHANNEL_NAME=트로트 라디오
TAKEDOWN_EMAIL=
