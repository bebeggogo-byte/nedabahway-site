{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nedabahway Resource Item",
  "type": "object",
  "required": ["id", "format", "visibility", "title", "summary", "version", "published", "url", "qa_passed"],
  "properties": {
    "id": {"type": "string", "pattern": "^(wks|tpl|evd|prm|dgn|gid|crt|med)-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"},
    "format": {"enum": ["wks", "tpl", "evd", "prm", "dgn", "gid", "crt", "med"]},
    "visibility": {"enum": ["public", "internal", "draft"]},
    "title": {"type": "string", "minLength": 4},
    "summary": {"type": "string", "minLength": 20},
    "topics": {"type": "array", "items": {"type": "string"}},
    "audiences": {"type": "array", "items": {"type": "string"}},
    "level": {"enum": ["beginner", "intermediate", "advanced", "any"]},
    "time_min": {"type": "integer"},
    "printable": {"type": "boolean"},
    "version": {"type": "string"},
    "published": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "source_dept": {"type": "string"},
    "cites": {"type": "array", "items": {"type": "string"}},
    "url": {"type": "string"},
    "qa_passed": {"type": "boolean"},
    "qa_check": {
      "type": "object",
      "properties": {
        "unique": {"type": "boolean"},
        "cited": {"type": "boolean"},
        "anonymized": {"type": "boolean"},
        "printable": {"type": "boolean"},
        "non_repetitive": {"type": "boolean"}
      }
    }
  }
}
