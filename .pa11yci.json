{
  "defaults": {
    "standard": "WCAG2AA",
    "timeout": 30000,
    "wait": 500,
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--disable-dev-shm-usage"
      ]
    },
    "ignore": [
      "warning",
      "notice"
    ],
    "threshold": 0
  },
  "urls": [
    {
      "url": "http://localhost:8080/index.html",
      "screenCapture": "tmp/a11y-index.png"
    },
    {
      "url": "http://localhost:8080/about.html",
      "screenCapture": "tmp/a11y-about.png"
    },
    {
      "url": "http://localhost:8080/programs.html",
      "screenCapture": "tmp/a11y-programs.png"
    },
    {
      "url": "http://localhost:8080/tools.html",
      "screenCapture": "tmp/a11y-tools.png"
    },
    {
      "url": "http://localhost:8080/contact.html",
      "screenCapture": "tmp/a11y-contact.png"
    },
    {
      "url": "http://localhost:8080/auto/tools/lead-scoring/index.html",
      "screenCapture": "tmp/a11y-auto-tools-lead-scoring-index.png"
    },
    {
      "url": "http://localhost:8080/auto/tools/meeting-actions/index.html",
      "screenCapture": "tmp/a11y-auto-tools-meeting-actions-index.png"
    },
    {
      "url": "http://localhost:8080/404.html",
      "screenCapture": "tmp/a11y-404.png"
    }
  ]
}
