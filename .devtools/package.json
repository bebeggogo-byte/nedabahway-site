{
  "name": "nedabah-site-devtools",
  "version": "1.0.0",
  "private": true,
  "description": "nedabah.org 사이트 개발·검증 도구 (CI에서도 사용)",
  "scripts": {
    "lhci": "lhci autorun",
    "lint:html": "htmlhint '../**/*.html' --ignore '../node_modules/**,../_archive_v2/**,../_archive_magazine_old/**'",
    "lint:css": "stylelint '../assets/**/*.css'",
    "format": "prettier --write '../**/*.{html,css,js,json,md}'",
    "format:check": "prettier --check '../**/*.{html,css,js,json,md}'"
  },
  "devDependencies": {
    "@lhci/cli": "^0.13.0",
    "htmlhint": "^1.1.4",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "prettier": "^3.2.0",
    "sharp-cli": "^5.0.0"
  }
}
